# TrustVault Environment Configuration Example

# Backend Core
PROJECT_NAME="TrustVault"
VERSION="1.0.0"
SECRET_KEY="generate-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for Production, SQLite for Local Dev)
DATABASE_URL="postgresql://vaultadmin:SuperSecretVaultDbPass2026!@localhost:5432/trustvault"

# Storage
STORAGE_DIR="./storage/private"
MAX_FILE_SIZE_BYTES=52428800

# PostgreSQL Docker Configuration
POSTGRES_DB="trustvault"
POSTGRES_USER="vaultadmin"
POSTGRES_PASSWORD="SuperSecretVaultDbPass2026!"

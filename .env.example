# Copy to .env and set independent generated secrets before starting Docker Compose.
# Generate each value with: python -c "import secrets; print(secrets.token_hex(32))"

# Backend Core
PROJECT_NAME="TrustVault"
VERSION="1.0.0"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local development uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL="sqlite:///./trustvault.db"

# Storage
STORAGE_DIR="./storage/private"
MAX_FILE_SIZE_BYTES=52428800

# PostgreSQL Docker Configuration
POSTGRES_DB="trustvault"
POSTGRES_USER="vaultadmin"
POSTGRES_PASSWORD=""
